<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Component products (templates auto-created by product.product). -->
        <record id="product_combo_stand" model="product.product">
            <field name="name">Adjustable Laptop Stand</field>
            <field name="type">consu</field>
            <field name="list_price">45.00</field>
        </record>
        <record id="product_combo_mouse" model="product.product">
            <field name="name">Wireless Mouse</field>
            <field name="type">consu</field>
            <field name="list_price">25.00</field>
        </record>
        <record id="product_combo_hub" model="product.product">
            <field name="name">USB-C Docking Hub</field>
            <field name="type">consu</field>
            <field name="list_price">60.00</field>
        </record>

        <!-- The combo product itself. -->
        <record id="product_combo_home_office" model="product.template">
            <field name="name">Home Office Starter Kit</field>
            <field name="type">consu</field>
            <field name="list_price">130.00</field>
            <field name="is_dynamic_combo" eval="True"/>
            <field name="dynamic_combo_pricing">sum</field>
        </record>

        <!-- Its default components. -->
        <record id="combo_component_stand" model="sale.combo.component">
            <field name="product_tmpl_id" ref="product_combo_home_office"/>
            <field name="component_product_id" ref="product_combo_stand"/>
            <field name="quantity">1</field>
            <field name="sequence">10</field>
        </record>
        <record id="combo_component_mouse" model="sale.combo.component">
            <field name="product_tmpl_id" ref="product_combo_home_office"/>
            <field name="component_product_id" ref="product_combo_mouse"/>
            <field name="quantity">1</field>
            <field name="sequence">20</field>
        </record>
        <record id="combo_component_hub" model="sale.combo.component">
            <field name="product_tmpl_id" ref="product_combo_home_office"/>
            <field name="component_product_id" ref="product_combo_hub"/>
            <field name="quantity">1</field>
            <field name="sequence">30</field>
        </record>
    </data>
</odoo>
